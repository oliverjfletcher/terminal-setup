# Ghostty config. Reload with cmd+shift+, ; list options with
# `ghostty +show-config --default --docs`.

# Look: Kanagawa matches the tmux theme; follows macOS light/dark.
theme = light:Kanagawa Lotus,dark:Kanagawa Wave
font-family = MesloLGS Nerd Font Mono
font-size = 14
window-padding-x = 8
window-padding-y = 6
window-padding-balance = true
macos-titlebar-style = tabs
unfocused-split-opacity = 0.85

# Option is Alt, so fzf's alt-c, zsh word motions (alt-b / alt-f) and
# readline shortcuts work. Without this, option types special characters.
macos-option-as-alt = true

# Over SSH, copy Ghostty's terminfo to the host (and fall back to
# xterm-256color), so remote vim/htop/tmux don't fail with
# "unknown terminal type xterm-ghostty".
shell-integration-features = ssh-terminfo,ssh-env

# Notify when a command that ran over 30s finishes while the window is in the
# background - long brew/terraform/kubectl runs.
notify-on-command-finish = unfocused
notify-on-command-finish-after = 30s
notify-on-command-finish-action = bell,notify

# Drop-down terminal from anywhere. Needs Accessibility permission the
# first time (System Settings > Privacy & Security > Accessibility).
keybind = global:cmd+grave_accent=toggle_quick_terminal

window-save-state = always
mouse-hide-while-typing = true
copy-on-select = clipboard
