# Kubernetes + GitOps. Installed by default.

brew "kubernetes-cli"
brew "helm"
brew "k9s"
brew "kubectx"
brew "kustomize"
brew "kind"
brew "stern"                # multi-pod log tailing
brew "kubecolor"
brew "krew"                 # kubectl plugin manager
brew "helmfile"
brew "kubeseal"
brew "kubeconform"
brew "cilium-cli"
brew "cmctl"
brew "ingress2gateway"
brew "crane"                # OCI registry inspection
brew "dive"                 # container image layer explorer
brew "docker"               # CLI only; the runtime comes from OrbStack

tap "argoproj/tap"
brew "argocd"
brew "argoproj/tap/kubectl-argo-rollouts"

tap "fluxcd/tap"
brew "fluxcd/tap/flux"
